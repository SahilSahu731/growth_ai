# Core application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_SECRET="replace-with-the-same-or-an-independent-secret"

# Separate administrator authentication. Admins are not application users and
# do not have a role in the users table. A bcrypt hash is recommended; a plain
# value is accepted for local compatibility. Generate a bcrypt hash with:
# node -e "console.log(require('bcryptjs').hashSync('replace-me', 12))"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
# Alternatively set ADMIN_PASSWORD instead of ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=""
# A random value of at least 32 characters is strongly recommended.
ADMIN_SESSION_SECRET=""
# Increment this value to immediately invalidate every active admin session.
ADMIN_SESSION_VERSION="1"

# Convex. The deploy key is server-only.
CONVEX_DEPLOYMENT="dev:your-deployment"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOY_KEY="dev:your-deployment|your-key"

# Account authentication (Google is the only enabled sign-in provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Growth operator model (optional; deterministic fallback is built in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Razorpay test/live credentials and dashboard plan IDs
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO_MONTHLY=""
RAZORPAY_PLAN_ID_FOUNDER=""
