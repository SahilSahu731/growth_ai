# Core application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
ENABLE_HSTS="0"

# Legal/public-beta identity. Production validation requires real reviewed values.
LEGAL_ENTITY_NAME=""
LEGAL_JURISDICTION=""
LEGAL_CONTACT_ADDRESS=""
LEGAL_CONTACT_EMAIL="privacy@growthai.app"
SECURITY_CONTACT_EMAIL="security@growthai.app"
SUPPORT_CONTACT_EMAIL="support@growthai.app"
MINIMUM_USER_AGE="18"

# Separate named administrator identities. Admins are not application users.
# Each production account requires a bcrypt password hash, a unique Base32 TOTP
# secret enrolled in an authenticator, and least-privilege roles.
ADMIN_ACCOUNTS_JSON=""
# Generate a distinct service-wide value with `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=""
# Increment this value to immediately invalidate every active admin session.
ADMIN_SESSION_VERSION="1"
# Legacy development-only single-account variables (not accepted for production):
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_TOTP_SECRET=""
ADMIN_ROLES=""
# Number of reverse-proxy hops controlled by your platform. Leave 0 locally;
# never trust arbitrary X-Forwarded-For values without this boundary.
TRUSTED_PROXY_HOPS="0"

# Convex deployment selection. CONVEX_DEPLOY_KEY belongs only in the isolated
# CI/deployment job and must never be configured in the web runtime.
CONVEX_DEPLOYMENT="dev:your-deployment"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_AUTH_BASE_URL="http://localhost:3000"

# Scoped Convex application identities. Generate independent PKCS#8 RSA keys
# with `npm run convex:keys`; keep the generated env file outside Git.
CONVEX_MEMBER_JWT_PRIVATE_KEY=""
CONVEX_MEMBER_JWT_KEY_ID="growthai-member-v1"
CONVEX_ADMIN_JWT_PRIVATE_KEY=""
CONVEX_ADMIN_JWT_KEY_ID="growthai-admin-v1"
CONVEX_WEBHOOK_JWT_PRIVATE_KEY=""
CONVEX_WEBHOOK_JWT_KEY_ID="growthai-webhook-v1"
CONVEX_BACKGROUND_JWT_PRIVATE_KEY=""
CONVEX_BACKGROUND_JWT_KEY_ID="growthai-background-v1"
CONVEX_AUTH_JWT_PRIVATE_KEY=""
CONVEX_AUTH_JWT_KEY_ID="growthai-auth-v1"

# Account authentication (Google is the only enabled sign-in provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Growth operator model (optional; deterministic fallback is built in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# Copy the current provider pricing; do not hard-code rates in application code.
GEMINI_INPUT_COST_PER_MILLION_USD=""
GEMINI_OUTPUT_COST_PER_MILLION_USD=""
# Emergency model-provider kill switch; deterministic guidance remains active.
GEMINI_DISABLED="0"

# Razorpay test/live credentials and dashboard plan IDs
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO_MONTHLY=""
RAZORPAY_PLAN_ID_FOUNDER=""
# Emergency switch for new sales. Set to "true" only after the paid-lifecycle
# checklist passes. Existing subscriptions and webhook processing stay active.
BILLING_CHECKOUT_ENABLED="false"

# Transactional email (Resend). Use separate test and production projects.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
TRANSACTIONAL_EMAIL_FROM="GrowthAI <account@updates.growthai.app>"
