# Core application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Separate administrator authentication. Admins are not application users.
# Production validation accepts only a bcrypt hash. Generate one with:
# node -e "console.log(require('bcryptjs').hashSync('replace-me', 12))"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
# Generate a distinct value with `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=""
# Increment this value to immediately invalidate every active admin session.
ADMIN_SESSION_VERSION="1"

# Convex. The deploy key is server-only.
CONVEX_DEPLOYMENT="dev:your-deployment"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOY_KEY="dev:your-deployment|your-key"

# Account authentication (Google is the only enabled sign-in provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Growth operator model (optional; deterministic fallback is built in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# Copy the current provider pricing; do not hard-code rates in application code.
GEMINI_INPUT_COST_PER_MILLION_USD=""
GEMINI_OUTPUT_COST_PER_MILLION_USD=""
# Emergency model-provider kill switch; deterministic guidance remains active.
GEMINI_DISABLED="0"

# Razorpay test/live credentials and dashboard plan IDs
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO_MONTHLY=""
RAZORPAY_PLAN_ID_FOUNDER=""
