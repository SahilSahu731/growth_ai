# Core application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_SECRET="replace-with-the-same-or-an-independent-secret"

# Convex. The deploy key is server-only.
CONVEX_DEPLOYMENT="dev:your-deployment"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOY_KEY="dev:your-deployment|your-key"

# Account authentication (Google is the only enabled sign-in provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional GitHub evidence integration; this is not an account sign-in method.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App webhook
GITHUB_WEBHOOK_SECRET=""

# Accountability model (optional; deterministic fallback is built in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Transactional email
RESEND_API_KEY=""
EMAIL_FROM="GrowthAI <accountability@example.com>"
CRON_SECRET="replace-with-an-independent-random-secret"

# Razorpay test/live credentials and dashboard plan IDs
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO_MONTHLY=""
RAZORPAY_PLAN_ID_FOUNDER=""

# Server-evaluated rollout flags
FEATURE_AI_PATTERNS="true"
FEATURE_BILLING="false"
FEATURE_GITHUB="false"
FEATURE_PUBLIC_PAGES="true"
FEATURE_REFERRALS="false"
