# Neon PostgreSQL connection string
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional alias used by this project (falls back to NEXTAUTH_SECRET)
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL for auth callbacks in local development
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional aliases also supported:
# GOOGLE_ID=""
# GOOGLE_SECRET=""

GITHUB_ID=""
GITHUB_SECRET=""
# Optional aliases also supported:
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Gemini API (required for AI-assisted goal roadmap generation)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
