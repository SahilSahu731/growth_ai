{
  "name": "growth_ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev",
    "convex:keys": "tsx scripts/generate-convex-identity-keys.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src",
    "test:integration": "vitest run convex",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "security:scan": "./scripts/security-scan.sh --tracked",
    "license:check": "license-checker-rseidelsohn --production --excludePackages 'growth_ai@0.1.0' --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;CC-BY-4.0;Python-2.0;OFL-1.1;LGPL-3.0-or-later'",
    "hooks:install": "git config core.hooksPath .githooks",
    "validate:env": "tsx scripts/validate-env.ts",
    "build:production": "npm run validate:env && next build --webpack"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/special-gothic-expanded-one": "^5.3.0",
    "@google/genai": "^2.16.0",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.7.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "convex-test": "^0.0.55",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
